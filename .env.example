# Production file: /etc/serverwatch/serverwatch.env (root:serverwatch 0640).
# Generate with scripts/setup_environment.py; never source this file in a shell.
SECRET_KEY=
ENCRYPTION_KEY=
PUBLIC_BASE_URL=
DATABASE_URL=mysql+pymysql://serverwatch:CHANGE_ME@127.0.0.1/serverwatch?charset=utf8mb4
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
SSH_KNOWN_HOSTS=/etc/serverwatch/known_hosts
SSH_TIMEOUT=12
MONITOR_CONCURRENCY=2
# false only with deploy/nginx-tunnel.conf behind an SSH tunnel; true for HTTPS.
SESSION_COOKIE_SECURE=true
AI_ENABLED=false
AI_URL=http://127.0.0.1:11434/api/generate
AI_MODEL=llama3.2:1b

#!/usr/bin/python3 -I
"""Fixed, root-only helper for one persistent 2 GiB swap file."""

import fcntl
import json
import os
import stat
import subprocess
import sys
from pathlib import Path

DIRECTORY = Path("/var/lib/serverwatch-swap")
SWAP = DIRECTORY / "persistent"
SIZE = 2 * 1024**3
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C"}


def run(*args):
    return subprocess.run(
        args, capture_output=True, text=True, timeout=20, env=ENV, check=True
    ).stdout.strip()


def active_swap():
    return {
        fields[0]: int(fields[2]) * 1024
        for fields in (line.split() for line in Path("/proc/swaps").read_text().splitlines()[1:])
    }


def persist():
    unit = run("/usr/bin/systemd-escape", "--path", "--suffix=swap", str(SWAP))
    path = Path("/etc/systemd/system") / unit
    content = f"[Swap]\nWhat={SWAP}\n\n[Install]\nWantedBy=swap.target\n".encode()
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    except FileExistsError:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError("unsafe_unit")
        if path.read_bytes() != content:
            raise ValueError("unsafe_unit")
    else:
        with os.fdopen(descriptor, "wb") as target:
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
    run("/usr/bin/systemctl", "daemon-reload")
    run("/usr/bin/systemctl", "enable", "--", unit)
    run("/usr/bin/systemctl", "is-enabled", "--", unit)


def provision():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise ValueError("privileges")
    os.umask(0o077)
    DIRECTORY.mkdir(mode=0o700, exist_ok=True)
    directory = DIRECTORY.lstat()
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or directory.st_mode & 0o022:
        raise ValueError("unsafe_directory")
    with os.fdopen(
        os.open(DIRECTORY / "operation.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600), "rb+"
    ) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        active = active_swap()
        if str(SWAP) in active:
            persist()
            return "already_active"
        # Swap space excludes the header page on Linux.
        if sum(active.values()) >= SIZE - os.sysconf("SC_PAGESIZE"):
            return "already_active"
        fs = run(
            "/usr/bin/findmnt", "--noheadings", "--output", "FSTYPE", "--target", str(DIRECTORY)
        )
        if fs not in ("ext4", "xfs"):
            raise ValueError("unsupported_filesystem")
        try:
            info = SWAP.lstat()
        except FileNotFoundError:
            usage = os.statvfs(DIRECTORY)
            if usage.f_bavail * usage.f_frsize < SIZE + 512 * 1024**2:
                raise ValueError("insufficient_space") from None
            descriptor = os.open(SWAP, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, "wb") as target:
                block = bytes(1024**2)
                for _ in range(2048):
                    target.write(block)
                target.flush()
                os.fsync(target.fileno())
            run("/usr/sbin/mkswap", str(SWAP))
        else:
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0
                or info.st_mode & 0o077
                or info.st_nlink != 1
                or info.st_size != SIZE
                or run("/usr/sbin/blkid", "-p", "-s", "TYPE", "-o", "value", str(SWAP)) != "swap"
            ):
                raise ValueError("unsafe_existing_file")
        run("/usr/sbin/swapon", str(SWAP))
        if str(SWAP) not in active_swap():
            raise ValueError("activation_unconfirmed")
        persist()
        return "created"


if __name__ == "__main__":
    try:
        print(json.dumps({"status": provision()}))
    except ValueError as error:
        print(json.dumps({"status": "denied", "code": str(error)}))
    except (OSError, subprocess.SubprocessError):
        print(json.dumps({"status": "denied", "code": "operation_failed"}))
